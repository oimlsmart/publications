---
import Base from '../../layouts/Base.astro'
import { loadDataset, BASE_PATH } from '../../data/publications'
import { ALL_DOCTYPES, DOCTYPE_LABELS, type Status } from '../../data/types'
import PubCard from '../../components/PubCard.astro'

export async function getStaticPaths() {
  return ALL_DOCTYPES.map(dt => ({ params: { doctype: dt } }))
}

const { doctype } = Astro.params as { doctype: typeof ALL_DOCTYPES[number] }
const data = loadDataset()
const series = (data.byDoctype[doctype] ?? []).sort((a, b) => parseInt(a.docnumber) - parseInt(b.docnumber))
const label = DOCTYPE_LABELS[doctype]

// Status counts within this doctype
const statusCounts: Record<Status, number> = { 'in-force': 0, 'superseded': 0, 'withdrawn': 0, 'draft': 0, 'unknown': 0 }
for (const s of series) {
  if (s.currentEdition) statusCounts[s.currentEdition.status]++
}
---

<Base title={label.plural} currentPath={`/browse/${doctype}`}>
  <section class="px-8 pt-12 pb-6 border-b border-rule">
    <div class="max-w-7xl mx-auto">
      <div class="bp-section-anchor mb-3">
        <span class="bp-section-anchor__num">§ {label.plural[0]}</span>
        <span>{label.plural}</span>
        <span class="bp-section-anchor__line"></span>
        <span class="bp-coord">{series.length} publications</span>
      </div>
      <h1 class="font-serif text-4xl font-medium tracking-tight mb-3">{label.plural}</h1>
      <p class="text-ink-soft max-w-2xl">
        {series.length.toLocaleString('en-US')} {label.singular.toLowerCase()} publications in the archive.
      </p>
      <a href={`${BASE_PATH}/browse/`} class="text-sm text-accent hover:underline mt-3 inline-block">← Back to all publications</a>
    </div>
  </section>

  <section class="px-8 py-6 border-b border-rule bg-paper-soft dark:bg-paper">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center gap-3 text-sm">
      <span class="font-mono text-xs uppercase tracking-wide text-ink-muted">Filter by status:</span>
      <button data-status-filter="all" class="px-3 py-1 text-xs font-mono border border-rule rounded-sm hover:border-accent status-filter status-filter--active">All ({series.length})</button>
      <button data-status-filter="in-force" class="px-3 py-1 text-xs font-mono border border-rule rounded-sm hover:border-accent status-filter">In force ({statusCounts['in-force']})</button>
      <button data-status-filter="superseded" class="px-3 py-1 text-xs font-mono border border-rule rounded-sm hover:border-accent status-filter">Superseded ({statusCounts['superseded']})</button>
      <button data-status-filter="withdrawn" class="px-3 py-1 text-xs font-mono border border-rule rounded-sm hover:border-accent status-filter">Withdrawn ({statusCounts['withdrawn']})</button>
      <span class="flex-1"></span>
      <span class="font-mono text-xs uppercase tracking-wide text-ink-muted">Sort by:</span>
      <select id="sort-select" class="px-2 py-1 text-xs font-mono border border-rule rounded-sm bg-paper-soft dark:bg-paper-deep">
        <option value="docnumber">Doc number</option>
        <option value="title">Title (A–Z)</option>
        <option value="year-desc">Year (newest first)</option>
        <option value="year-asc">Year (oldest first)</option>
      </select>
    </div>
  </section>

  <section class="px-8 py-6">
    <div class="max-w-7xl mx-auto">
      <div id="pub-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4" data-total={series.length}>
        {series.map(s => (
          <div
            class="pub-card-wrapper"
            data-status={s.currentEdition?.status ?? 'unknown'}
            data-docnumber={parseInt(s.docnumber) || 0}
            data-title={(s.title.eng ?? s.title.fra ?? s.docid).toLowerCase()}
            data-year={s.currentEdition?.year ?? 0}
          >
            <PubCard series={s} />
          </div>
        ))}
      </div>
      <p id="no-results" class="hidden text-center text-ink-muted py-12 font-mono text-sm">
        No publications match this filter.
      </p>
    </div>
  </section>

  <script is:inline>
    const buttons = document.querySelectorAll('.status-filter')
    const grid = document.getElementById('pub-grid')
    const cards = grid ? Array.from(grid.querySelectorAll('.pub-card-wrapper')) : []
    const noResults = document.getElementById('no-results')
    const sortSelect = document.getElementById('sort-select')

    function setStatus(status) {
      let visible = 0
      cards.forEach(card => {
        const show = status === 'all' || card.dataset.status === status
        card.style.display = show ? '' : 'none'
        if (show) visible++
      })
      if (noResults) noResults.classList.toggle('hidden', visible > 0)
    }

    function sortCards(by) {
      const sorted = [...cards].sort((a, b) => {
        if (by === 'docnumber') return parseInt(a.dataset.docnumber) - parseInt(b.dataset.docnumber)
        if (by === 'title') return (a.dataset.title || '').localeCompare(b.dataset.title || '')
        if (by === 'year-desc') return parseInt(b.dataset.year) - parseInt(a.dataset.year)
        if (by === 'year-asc') return parseInt(a.dataset.year) - parseInt(b.dataset.year)
        return 0
      })
      sorted.forEach(c => grid.appendChild(c))
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('status-filter--active'))
        btn.classList.add('status-filter--active')
        setStatus(btn.dataset.statusFilter)
      })
    })

    // Active filter styling
    const style = document.createElement('style')
    style.textContent = '.status-filter--active { border-color: var(--color-brand-500, #1a6fc2); color: var(--color-brand-600, #004996); font-weight: 600; }'
    document.head.appendChild(style)

    sortSelect?.addEventListener('change', () => sortCards(sortSelect.value))
  </script>
</Base>