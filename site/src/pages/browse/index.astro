---
import Base from '../../layouts/Base.astro'
import { loadDataset, BASE_PATH } from '../../data/publications'
import { ALL_DOCTYPES, DOCTYPE_LABELS } from '../../data/types'
import PubCard from '../../components/PubCard.astro'

const data = loadDataset()
// Sort works by docnumber then year
const allWorks = [...data.works.values()].sort((a, b) => {
  const an = parseInt(a.docnumber) || 0
  const bn = parseInt(b.docnumber) || 0
  if (an !== bn) return an - bn
  return (a.year ?? 0) - (b.year ?? 0)
})

const stats = data.stats
---

<Base title="Browse publications" currentPath="/browse">
  <section class="px-8 pt-12 pb-6 border-b border-rule">
    <div class="max-w-7xl mx-auto">
      <div class="bp-section-anchor mb-3">
        <span class="bp-section-anchor__num">§ B</span>
        <span>Browse</span>
        <span class="bp-section-anchor__line"></span>
        <span class="bp-coord">{stats.totalWorks} works</span>
      </div>
      <h1 class="font-serif text-4xl font-medium tracking-tight mb-3">Browse all publications</h1>
      <p class="text-ink-soft max-w-2xl">
        {stats.totalWorks.toLocaleString('en-US')} work-level publications, {stats.totalInstances.toLocaleString('en-US')} language instances,
        {stats.totalPdfsWithFile.toLocaleString('en-US')} PDFs mirrored.
      </p>
    </div>
  </section>

  <section class="px-8 py-6">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-rule border border-rule rounded-md overflow-hidden mb-8">
        {ALL_DOCTYPES.map(dt => (
          <a href={`${BASE_PATH}/browse/${dt}/`} class="bg-paper-soft dark:bg-paper p-4 hover:bg-paper dark:hover:bg-paper-deep transition-colors">
            <div class="text-xs font-mono uppercase text-ink-soft tracking-wide mb-1">{stats.byDoctype[dt] ?? 0}</div>
            <div class="font-serif text-base">{DOCTYPE_LABELS[dt].plural}</div>
          </a>
        ))}
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {allWorks.map(w => (
          <PubCard work={w} instanceCount={w.instances.length} />
        ))}
      </div>
    </div>
  </section>
</Base>
