---
import Base from '../../layouts/Base.astro'
import { loadDataset } from '../../data/publications'
import PubCard from '../../components/PubCard.astro'
import BrowseToolbar from '../../components/BrowseToolbar.astro'

const data = loadDataset()
const allSeries = [...data.series].sort((a, b) => {
  if (a.doctype !== b.doctype) return a.doctype.localeCompare(b.doctype)
  return parseInt(a.docnumber) - parseInt(b.docnumber)
})
const stats = data.stats
---

<Base title="Browse publications" currentPath="/browse">
  <section class="relative px-8 pt-12 pb-8 border-b border-rule bp-grid bp-grid--major bp-noise">
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="bp-section-anchor mb-3">
        <span class="bp-section-anchor__num">§ B</span>
        <span>Browse</span>
        <span class="bp-section-anchor__line"></span>
        <span class="bp-coord">{stats.totalSeries} publications</span>
      </div>
      <h1 class="font-serif text-4xl font-medium tracking-tight mb-3">Browse all publications</h1>
      <p class="text-ink-soft max-w-2xl">
        {stats.totalSeries.toLocaleString('en-US')} OIML publications across {stats.totalEditions.toLocaleString('en-US')} editions
        and {stats.totalPdfsWithFile.toLocaleString('en-US')} PDFs.
      </p>
    </div>
  </section>

  <BrowseToolbar series={allSeries} showDoctypeNav doctypeCounts={stats.byDoctype} />

  <section class="px-8 py-6">
    <div class="max-w-7xl mx-auto">
      <div id="pub-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {allSeries.map(s => (
          <div
            class="pub-card-wrapper"
            data-status={s.currentEdition?.status ?? 'unknown'}
            data-docnumber={parseInt(s.docnumber) || 0}
            data-title={(s.title.eng ?? s.title.fra ?? s.docid).toLowerCase()}
            data-year={s.currentEdition?.year ?? 0}
          >
            <PubCard series={s} />
          </div>
        ))}
      </div>
      <p id="no-results" class="hidden text-center text-ink-muted py-12 font-mono text-sm">
        No publications match this filter.
      </p>
    </div>
  </section>
</Base>
