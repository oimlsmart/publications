---
import Base from '../layouts/Base.astro'
import { BASE_PATH } from '../data/publications'
---

<Base title="Search" currentPath="/search">
  <section class="relative px-8 pt-12 pb-6 border-b border-rule bp-grid bp-grid--major bp-noise">
    <div class="max-w-4xl mx-auto relative z-10">
      <div class="bp-section-anchor mb-3">
        <span class="bp-section-anchor__num">§ ?</span>
        <span>Search</span>
        <span class="bp-section-anchor__line"></span>
        <span class="bp-coord">{'{'}Pagefind{'}'}</span>
      </div>
      <h1 class="font-serif text-4xl font-medium tracking-tight mb-4">Search publications</h1>
      <p class="text-ink-soft mb-6 max-w-2xl">
        Full-text search across every publication's title, scope, identifiers,
        technical committee, and bibliographic metadata. Results link directly
        to the matching publication page.
      </p>
    </div>
  </section>

  <section class="px-8 py-8">
    <div class="max-w-4xl mx-auto">
      <link rel="stylesheet" href={`${BASE_PATH}/pagefind/pagefind-ui.css`} />
      <div id="search" data-base-path={BASE_PATH}></div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var el = document.getElementById('search');
      if (!el) return;
      var basePath = el.dataset.basePath || '';
      var initialQuery = new URLSearchParams(window.location.search).get('q') || '';

      // Pagefind UI is an IIFE that attaches to window.PagefindUI —
      // load it via a script tag, not import().
      var link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = basePath + '/pagefind/pagefind-ui.css';
      document.head.appendChild(link);

      var script = document.createElement('script');
      script.src = basePath + '/pagefind/pagefind-ui.js';
      script.onload = function () {
        if (!window.PagefindUI) {
          el.innerHTML = '<p class="text-sm text-red-700 font-mono p-4">PagefindUI not found after script load.</p>';
          return;
        }
        new window.PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
          translations: {
            placeholder: 'Search publications…',
            zero_results: 'No matching publications found.',
          },
        });

        if (initialQuery) {
          var attempts = 0;
          (function poll() {
            if (++attempts > 50) return;
            var input = document.querySelector('#search input[type="search"]');
            if (input) {
              input.value = initialQuery;
              input.dispatchEvent(new Event('input', { bubbles: true }));
              return;
            }
            setTimeout(poll, 20);
          })();
        }
      };
      script.onerror = function () {
        el.innerHTML = '<p class="text-sm text-red-700 font-mono p-4">Failed to load search script.</p>';
      };
      document.head.appendChild(script);
    })();
  </script>
</Base>
