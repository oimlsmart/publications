---
import Base from '../layouts/Base.astro'
import { BASE_PATH } from '../data/publications'
import SearchBox from '../components/SearchBox.vue'
import PageHero from '../components/PageHero.astro'
---

<Base title="Search" currentPath="/search">
  <PageHero
    num="?"
    label="Search"
    coord="full-text index"
    container="sm"
    title="Search publications"
    lead="Full-text search across every publication's title, scope, identifiers, technical committee, and bibliographic metadata. Results link directly to the matching publication page."
    major
  />

  <section class="px-8 py-8">
    <div class="max-w-4xl mx-auto">
      <div id="pf-search" class="bp-search"></div>
      <SearchBox client:load basePath={BASE_PATH} />
    </div>
  </section>
</Base>
