---
import Base from '../layouts/Base.astro'
import { BASE_PATH } from '../data/publications'
import PageHero from '../components/PageHero.astro'
---

<Base title="Not found" currentPath="/404">
  <PageHero
    num="ERR"
    label="404"
    coord="outside the drawing"
    container="sm"
    title="Not found"
    lead="The publication or page you requested doesn't exist."
    major
  >
    <div class="flex gap-3 mt-2">
      <a href={`${BASE_PATH}/`} class="px-4 py-2 bg-accent text-paper-soft dark:text-paper-deep rounded-sm font-mono text-sm hover:bg-brand-700 transition-colors">← Home</a>
      <a href={`${BASE_PATH}/browse/`} class="px-4 py-2 border border-rule rounded-sm font-mono text-sm hover:border-accent transition-colors">Browse</a>
      <a href={`${BASE_PATH}/search/`} class="px-4 py-2 border border-rule rounded-sm font-mono text-sm hover:border-accent transition-colors">Search</a>
    </div>
  </PageHero>
</Base>
