---
import Base from '../layouts/Base.astro'
import { BASE_PATH } from '../data/publications'
---

<Base title="Not found" currentPath="/404">
  <section class="px-8 py-24">
    <div class="max-w-2xl mx-auto text-center">
      <div class="bp-section-anchor mb-3"><span class="bp-coord">404</span></div>
      <h1 class="font-serif text-5xl font-medium mb-3">Not found</h1>
      <p class="text-ink-soft mb-8">The publication or page you requested doesn't exist.</p>
      <a href={`${BASE_PATH}/`} class="px-4 py-2 bg-accent text-paper-soft dark:text-paper-deep rounded-sm font-mono">← Home</a>
    </div>
  </section>
</Base>