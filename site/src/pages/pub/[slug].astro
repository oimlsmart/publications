---
import Base from '../layouts/Base.astro'
import type { Series, Edition, Part, Instance } from '../data/types'
import { loadDataset, BASE_PATH } from '../data/publications'
import DoctypeChip from '../components/DoctypeChip.astro'
import StatusBadge from '../components/StatusBadge.astro'
import RelationList from '../components/RelationList.astro'
import PdfPreview from '../components/PdfPreview.astro'
import { LANG_LABELS } from '../data/types'

export async function getStaticPaths() {
  const data = loadDataset()
  const paths: any[] = []
  for (const s of data.series) {
    paths.push({ params: { slug: s.slug }, props: { series: s, kind: 'series' } })
    // Edition + part + instance URLs use the actual id slugs
    for (const ed of s.editions) {
      paths.push({ params: { slug: ed.slug }, props: { series: s, edition: ed, kind: 'edition' } })
      for (const p of ed.parts) {
        paths.push({ params: { slug: p.slug }, props: { series: s, edition: ed, part: p, kind: 'part' } })
      }
      for (const i of ed.instances) {
        paths.push({ params: { slug: i.slug }, props: { series: s, edition: ed, instance: i, kind: 'instance' } })
      }
      for (const p of ed.parts) {
        for (const i of p.instances) {
          paths.push({ params: { slug: i.slug }, props: { series: s, edition: ed, part: p, instance: i, kind: 'instance' } })
        }
      }
    }
  }
  return paths
}

const props = Astro.props
const data = loadDataset()
const { series } = props as { series: Series }

// Branch on kind
if (props.kind === 'series') {
  const title = series.title.eng ?? series.title.fra ?? series.docid
  const langs = series.currentEdition?.languages() ?? []
  const firstInst = firstInstanceWithPdf(series)
  const firstYaml = firstInst?.localYamlPath ?? (series.currentEdition?.parts[0]?.instances[0]?.localYamlPath)
---

<Base title={series.docid} currentPath={`/pub/${series.slug}`}>
  <slot name="head" slot="head">
    <link rel="alternate" type="application/json" href={`${BASE_PATH}/api/publications/${series.slug}`} />
    <meta property="og:title" content={series.docid} />
    <meta property="og:description" content={series.scope ?? title} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': ['Standard', 'CreativeWork'],
      '@id': `${BASE_PATH}/pub/${series.slug}/`,
      identifier: series.docid,
      name: title,
      description: series.scope,
      hasSuccessor: series.editions.flatMap(e => e.relations.filter(r => r.type === 'hasSuccessor').map(r => r.target)),
      publisher: { '@type': 'Organization', name: 'OIML' },
    })} />
  </slot>

  <section class="px-8 pt-12 pb-8 border-b border-rule">
    <div class="max-w-6xl mx-auto">
      <div class="bp-section-anchor mb-3">
        <span class="bp-section-anchor__num">§ {series.docnumber}</span>
        <span>{series.doctype}</span>
        <span class="bp-section-anchor__line"></span>
        <span class="bp-coord">{series.editions.length} edition{series.editions.length !== 1 ? 's' : ''}</span>
      </div>

      <div class="flex items-center gap-2 mb-3 flex-wrap">
        <DoctypeChip doctype={series.doctype} />
        <span class="font-mono text-sm text-ink-soft">{series.docid}</span>
        {series.currentEdition && <StatusBadge status={series.currentEdition.status} />}
        {series.highPriority && (
          <span class="px-2 py-0.5 text-xs font-mono uppercase border border-amber-400 bg-amber-50 dark:bg-amber-900/20 text-amber-800 dark:text-amber-200 rounded-sm">
            ★ High priority
          </span>
        )}
      </div>

      <h1 class="font-serif text-4xl font-medium leading-[1.1] tracking-tight mb-3">{title}</h1>
      {series.scope && <p class="text-lg text-ink-soft max-w-3xl mb-4">{series.scope}</p>}

      <dl class="grid sm:grid-cols-2 md:grid-cols-4 gap-4 text-sm font-mono mt-6">
        {series.tc && (<div><dt class="text-ink-soft uppercase text-xs tracking-wide">TC / SC</dt><dd class="text-base">{series.tc}</dd></div>)}
        {series.editions.length > 0 && (<div><dt class="text-ink-soft uppercase text-xs tracking-wide">First published</dt><dd class="text-base">{Math.min(...series.editions.map(e => e.year))}</dd></div>)}
        {series.editions.length > 0 && (<div><dt class="text-ink-soft uppercase text-xs tracking-wide">Latest edition</dt><dd class="text-base">{series.editions[0].year}</dd></div>)}
        {langs.length > 0 && (<div><dt class="text-ink-soft uppercase text-xs tracking-wide">Languages</dt><dd class="text-base">{langs.map(l => LANG_LABELS[l] ?? l).join(', ')}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="px-8 py-8 border-b border-rule">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-serif text-2xl mb-4">Editions</h2>
      <ul class="divide-y divide-rule border border-rule rounded-sm overflow-hidden">
        {series.editions.map(ed => {
          const title = ed.title.eng ?? ed.title.fra ?? ed.docid
          const isCurrent = ed.status === 'in-force'
          return (
            <li>
              <a href={`${BASE_PATH}/pub/${ed.slug}/`} class="block px-4 py-3 hover:bg-paper-soft dark:hover:bg-paper-deep transition-colors">
                <div class="flex items-center gap-3 flex-wrap">
                  <span class={`font-mono text-xs px-2 py-0.5 border rounded-sm ${isCurrent ? 'border-green-400 bg-green-50 dark:bg-green-900/30 text-green-800 dark:text-green-200' : 'border-rule'}`}>
                    {ed.year}
                  </span>
                  <span class="text-sm font-mono text-ink-soft">{ed.docid}</span>
                  <StatusBadge status={ed.status} />
                  <span class="text-xs text-ink-soft ml-auto">
                    {ed.parts.length > 0 ? `${ed.parts.length} parts · ` : ''}
                    {(ed.instances.length + ed.parts.reduce((s, p) => s + p.instances.length, 0))} language PDFs
                  </span>
                </div>
                {(title !== series.docid) && <div class="mt-1 text-sm">{title}</div>}
              </a>
            </li>
          )
        })}
      </ul>
    </div>
  </section>

  {series.currentEdition && (series.currentEdition.relations.length > 0) && (
    <section class="px-8 py-8">
      <div class="max-w-6xl mx-auto">
        <h2 class="font-serif text-2xl mb-4">Related publications</h2>
        <RelationList relations={series.currentEdition.relations} selfId={series.currentEdition.docid} />
      </div>
    </section>
  )}
</Base>

---
} else if (props.kind === 'edition') {
  const { series, edition: ed } = props as { series: Series; edition: Edition }
  const title = ed.title.eng ?? ed.title.fra ?? ed.docid
  const hasParts = ed.parts.length > 0
---

<Base title={ed.docid} currentPath={`/pub/${ed.slug}`}>
  <slot name="head" slot="head">
    <link rel="alternate" type="application/json" href={`${BASE_PATH}/api/publications/${ed.slug}`} />
    <meta property="og:title" content={ed.docid} />
    <meta property="og:description" content={ed.scope ?? title} />
    {ed.doi && <meta name="citation_doi" content={ed.doi} />}
    {ed.publishedAt && <meta name="citation_publication_date" content={ed.publishedAt} />}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': ['Standard', 'CreativeWork'],
      '@id': `${BASE_PATH}/pub/${ed.slug}/`,
      identifier: ed.docid,
      name: title,
      description: ed.scope,
      datePublished: ed.publishedAt,
      inLanguage: ed.languages(),
      isPartOf: `${BASE_PATH}/pub/${series.slug}/`,
      hasPart: ed.parts.map(p => `${BASE_PATH}/pub/${p.slug}/`),
      doi: ed.doi,
      publisher: { '@type': 'Organization', name: 'OIML' },
    })} />
  </slot>

  <section class="px-8 pt-10 pb-6 border-b border-rule">
    <div class="max-w-6xl mx-auto">
      <a href={`${BASE_PATH}/pub/${series.slug}/`} class="text-xs font-mono text-ink-soft hover:text-accent">← back to {series.docid}</a>
      <div class="flex items-center gap-2 mt-2 mb-3 flex-wrap">
        <DoctypeChip doctype={series.doctype} />
        <span class="font-mono text-sm text-ink-soft">{ed.docid}</span>
        <StatusBadge status={ed.status} />
      </div>
      <h1 class="font-serif text-3xl font-medium leading-tight tracking-tight mb-2">{title}</h1>
      {ed.scope && <p class="text-ink-soft max-w-3xl">{ed.scope}</p>}
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-8 py-6">
    {hasParts ? (
      <section>
        <h2 class="font-serif text-2xl mb-4">Parts</h2>
        <ul class="divide-y divide-rule border border-rule rounded-sm overflow-hidden">
          {ed.parts.map(p => {
            const pt = p.title.eng ?? p.title.fra ?? p.docid
            return (
              <li>
                <a href={`${BASE_PATH}/pub/${p.slug}/`} class="block px-4 py-4 hover:bg-paper-soft dark:hover:bg-paper-deep transition-colors">
                  <div class="flex items-center gap-3 flex-wrap mb-1">
                    <span class="font-mono text-xs px-2 py-0.5 border border-rule rounded-sm">Part {p.partNumber}</span>
                    <span class="text-sm font-mono text-ink-soft">{p.docid}</span>
                    <span class="text-xs text-ink-soft ml-auto">{p.instances.length} language{p.instances.length !== 1 ? 's' : ''}</span>
                  </div>
                  <div class="text-sm">{pt}</div>
                </a>
              </li>
            )
          })}
        </ul>
      </section>
    ) : (
      <section>
        <h2 class="font-serif text-2xl mb-4">Language editions</h2>
        {ed.instances.length === 0 ? (
          <p class="text-ink-soft text-sm">No language PDFs available.</p>
        ) : (
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {ed.instances.map(i => (
              <a href={`${BASE_PATH}/pub/${i.slug}/`} class="border border-rule p-4 rounded-sm hover:border-accent hover:shadow-md transition-all bg-paper-soft dark:bg-paper">
                <div class="flex items-center gap-2 mb-2">
                  <span class="px-2 py-0.5 text-xs font-mono uppercase border border-rule rounded-sm">{i.language}</span>
                  <span class="text-xs text-ink-soft">{LANG_LABELS[i.language] ?? i.language}</span>
                </div>
                <div class="text-sm font-mono text-ink-soft">{i.docid}</div>
                {i.localPdfPath ? (
                  <div class="text-xs mt-2 text-green-700 dark:text-green-300 font-mono">PDF available ({Math.round((i.fileSize ?? 0) / 1024 / 1024 * 10) / 10} MB)</div>
                ) : (
                  <div class="text-xs mt-2 text-amber-700 dark:text-amber-300 font-mono">No local PDF</div>
                )}
              </a>
            ))}
          </div>
        )}
      </section>
    )}
  </div>

  {ed.relations.length > 0 && (
    <section class="px-8 py-8 border-t border-rule">
      <div class="max-w-6xl mx-auto">
        <h2 class="font-serif text-2xl mb-4">Related publications</h2>
        <RelationList relations={ed.relations} selfId={ed.docid} />
      </div>
    </section>
  )}
</Base>

---
} else if (props.kind === 'part') {
  const { series, edition: ed, part: p } = props as { series: Series; edition: Edition; part: Part }
  const title = p.title.eng ?? p.title.fra ?? p.docid
---

<Base title={p.docid} currentPath={`/pub/${p.slug}`}>
  <slot name="head" slot="head">
    <link rel="alternate" type="application/json" href={`${BASE_PATH}/api/publications/${p.slug}`} />
    <meta property="og:title" content={p.docid} />
    <meta property="og:description" content={p.scope ?? title} />
  </slot>

  <section class="px-8 pt-10 pb-6 border-b border-rule">
    <div class="max-w-6xl mx-auto">
      <a href={`${BASE_PATH}/pub/${ed.slug}/`} class="text-xs font-mono text-ink-soft hover:text-accent">← back to {ed.docid}</a>
      <div class="flex items-center gap-2 mt-2 mb-3 flex-wrap">
        <DoctypeChip doctype={series.doctype} />
        <span class="px-2 py-0.5 text-xs font-mono uppercase border border-rule rounded-sm">Part {p.partNumber}</span>
        <span class="font-mono text-sm text-ink-soft">{p.docid}</span>
        <StatusBadge status={p.status} />
      </div>
      <h1 class="font-serif text-3xl font-medium leading-tight tracking-tight mb-2">{title}</h1>
      {p.scope && <p class="text-ink-soft max-w-3xl">{p.scope}</p>}
    </div>
  </section>

  <section class="px-8 py-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-serif text-2xl mb-4">Language editions</h2>
      {p.instances.length === 0 ? (
        <p class="text-ink-soft text-sm">No language PDFs available.</p>
      ) : (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {p.instances.map(i => (
            <a href={`${BASE_PATH}/pub/${i.slug}/`} class="border border-rule p-4 rounded-sm hover:border-accent hover:shadow-md transition-all bg-paper-soft dark:bg-paper">
              <div class="flex items-center gap-2 mb-2">
                <span class="px-2 py-0.5 text-xs font-mono uppercase border border-rule rounded-sm">{i.language}</span>
                <span class="text-xs text-ink-soft">{LANG_LABELS[i.language] ?? i.language}</span>
              </div>
              <div class="text-sm font-mono text-ink-soft">{i.docid}</div>
              {i.localPdfPath ? (
                <div class="text-xs mt-2 text-green-700 dark:text-green-300 font-mono">PDF available ({Math.round((i.fileSize ?? 0) / 1024 / 1024 * 10) / 10} MB)</div>
              ) : (
                <div class="text-xs mt-2 text-amber-700 dark:text-amber-300 font-mono">No local PDF</div>
              )}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  {p.relations.length > 0 && (
    <section class="px-8 py-6 border-t border-rule">
      <div class="max-w-6xl mx-auto">
        <h2 class="font-serif text-2xl mb-4">Related publications</h2>
        <RelationList relations={p.relations} selfId={p.docid} />
      </div>
    </section>
  )}
</Base>

---
} else {
  // instance view with PDF preview
  const { series, edition: ed, part: p, instance: inst } = props as {
    series: Series; edition: Edition; part?: Part; instance: Instance
  }
  const title = (p?.title[inst.language] ?? ed.title[inst.language] ?? inst.docid) as string | undefined
  const parent = p ?? ed
  const siblingInstances = p
    ? p.instances.filter(i => i.id !== inst.id)
    : ed.instances.filter(i => i.id !== inst.id)
  const workSlug = (p ?? ed).slug
---

<Base title={inst.docid} currentPath={`/pub/${inst.slug}`}>
  <slot name="head" slot="head">
    <link rel="alternate" type="application/yaml" href={inst.localYamlPath} />
    {inst.localPdfPath && <link rel="alternate" type="application/pdf" href={inst.localPdfPath} />}
    <link rel="alternate" type="application/json" href={`${BASE_PATH}/api/publications/${inst.slug}`} />
    <meta property="og:title" content={inst.docid} />
    <meta property="og:description" content={(p?.scope ?? ed.scope) ?? title} />
    {inst.doi && <meta name="citation_doi" content={inst.doi} />}
    {inst.publishedAt && <meta name="citation_publication_date" content={inst.publishedAt} />}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': ['Standard', 'CreativeWork'],
      '@id': `${BASE_PATH}/pub/${inst.slug}/`,
      identifier: inst.docid,
      name: title,
      description: p?.scope ?? ed.scope,
      datePublished: inst.publishedAt,
      inLanguage: inst.language,
      encoding: inst.localPdfPath ? [{
        '@type': 'MediaObject',
        encodingFormat: 'application/pdf',
        contentUrl: inst.localPdfPath,
      }] : undefined,
      doi: inst.doi,
      isPartOf: `${BASE_PATH}/pub/${workSlug}/`,
      publisher: { '@type': 'Organization', name: 'OIML' },
    })} />
  </slot>

  <section class="px-8 pt-10 pb-6 border-b border-rule">
    <div class="max-w-7xl mx-auto">
      <a href={`${BASE_PATH}/pub/${workSlug}/`} class="text-xs font-mono text-ink-soft hover:text-accent">← back to {parent.docid}</a>
      <div class="flex items-center gap-2 mt-2 mb-3 flex-wrap">
        <DoctypeChip doctype={series.doctype} />
        {p && <span class="px-2 py-0.5 text-xs font-mono uppercase border border-rule rounded-sm">Part {p.partNumber}</span>}
        <span class="px-2 py-0.5 text-xs font-mono uppercase border border-rule rounded-sm">{inst.language}</span>
        <span class="text-xs text-ink-soft">{LANG_LABELS[inst.language] ?? inst.language}</span>
        <StatusBadge status={parent.status} />
      </div>
      <h1 class="font-serif text-3xl font-medium leading-tight tracking-tight mb-2">{title}</h1>
      <p class="font-mono text-sm text-ink-soft">{inst.docid}</p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-8 py-6 grid lg:grid-cols-[1fr_22rem] gap-6">
    <div>
      {inst.localPdfPath ? (
        <PdfPreview pdfPath={inst.localPdfPath.replace(`${BASE_PATH}/pdfs/`, '')} />
      ) : (
        <div class="border border-rule p-8 rounded-sm bg-paper-soft dark:bg-paper">
          <p class="text-ink-soft">No PDF available locally.</p>
          {inst.sourceUrl && (
            <a href={inst.sourceUrl} class="text-accent hover:underline text-sm font-mono mt-2 inline-block">{inst.sourceUrl}</a>
          )}
        </div>
      )}

      {siblingInstances.length > 0 && (
        <section class="mt-8">
          <h2 class="font-serif text-xl mb-3">Other languages</h2>
          <div class="flex gap-2 flex-wrap">
            {siblingInstances.sort((a, b) => a.language.localeCompare(b.language)).map(s => (
              <a href={`${BASE_PATH}/pub/${s.slug}/`} class="px-3 py-1.5 text-sm border border-rule rounded-sm hover:border-accent hover:shadow-sm transition-all">
                {s.language} · {LANG_LABELS[s.language] ?? s.language}
              </a>
            ))}
          </div>
        </section>
      )}
    </div>

    <aside class="space-y-6 text-sm">
      <div>
        <h2 class="font-serif text-lg mb-2">Metadata</h2>
        <dl class="space-y-2 font-mono text-xs">
          {ed.year > 0 && (<div class="flex justify-between gap-2"><dt class="text-ink-soft uppercase tracking-wide">Published</dt><dd>{ed.year}</dd></div>)}
          {ed.tc && (<div class="flex justify-between gap-2"><dt class="text-ink-soft uppercase tracking-wide">TC / SC</dt><dd>{ed.tc}</dd></div>)}
          {inst.fileSize && (<div class="flex justify-between gap-2"><dt class="text-ink-soft uppercase tracking-wide">PDF size</dt><dd>{Math.round(inst.fileSize / 1024 / 1024 * 10) / 10} MB</dd></div>)}
          {inst.doi && (<div class="flex justify-between gap-2"><dt class="text-ink-soft uppercase tracking-wide">DOI</dt><dd><a class="text-accent hover:underline" href={`https://doi.org/${inst.doi}`}>{inst.doi}</a></dd></div>)}
        </dl>
      </div>

      {(p?.scope ?? ed.scope) && (
        <div>
          <h2 class="font-serif text-lg mb-2">Scope</h2>
          <p class="text-ink-soft leading-relaxed">{p?.scope ?? ed.scope}</p>
        </div>
      )}

      <div>
        <h2 class="font-serif text-lg mb-2">Downloads</h2>
        <ul class="space-y-1 text-xs font-mono">
          {inst.localPdfPath && <li><a href={inst.localPdfPath} class="text-accent hover:underline">⬇ PDF (local mirror)</a></li>}
          {inst.sourceUrl && <li><a href={inst.sourceUrl} class="text-accent hover:underline">⬆ Upstream ({new URL(inst.sourceUrl).host})</a></li>}
          <li><a href={inst.localYamlPath} class="text-accent hover:underline">⬇ YAML record</a></li>
          <li><a href={`${BASE_PATH}/api/publications/${inst.slug}`} class="text-accent hover:underline">⬇ JSON record</a></li>
        </ul>
      </div>

      {inst.relations.length > 0 && (
        <div>
          <h2 class="font-serif text-lg mb-2">Relations</h2>
          <RelationList relations={inst.relations} selfId={inst.docid} />
        </div>
      )}
    </aside>
  </div>
</Base>

---
}

function firstInstanceWithPdf(series: Series): Instance | undefined {
  for (const ed of series.editions) {
    for (const i of ed.instances) if (i.localPdfPath) return i
    for (const p of ed.parts) for (const i of p.instances) if (i.localPdfPath) return i
  }
  return undefined
}
