---
import SeriesPage from '../../components/SeriesPage.astro'
import EditionPage from '../../components/EditionPage.astro'
import PartPage from '../../components/PartPage.astro'
import InstancePage from '../../components/InstancePage.astro'
import type { Series, Edition, Part, Instance } from '../../data/types'
import { loadDataset } from '../../data/publications'

export async function getStaticPaths() {
  const data = loadDataset()
  const paths: any[] = []
  for (const s of data.series) {
    paths.push({
      params: { slug: s.slug },
      props: { kind: 'series', series: s },
    })
    for (const ed of s.editions) {
      paths.push({
        params: { slug: ed.slug },
        props: { kind: 'edition', series: s, edition: ed },
      })
      for (const p of ed.parts) {
        paths.push({
          params: { slug: p.slug },
          props: { kind: 'part', series: s, edition: ed, part: p },
        })
      }
      for (const i of ed.instances) {
        paths.push({
          params: { slug: i.slug },
          props: { kind: 'instance', series: s, edition: ed, instance: i },
        })
      }
      for (const p of ed.parts) {
        for (const i of p.instances) {
          paths.push({
            params: { slug: i.slug },
            props: { kind: 'instance', series: s, edition: ed, part: p, instance: i },
          })
        }
      }
    }
  }
  return paths
}

interface Props {
  kind: 'series' | 'edition' | 'part' | 'instance'
  series: Series
  edition?: Edition
  part?: Part
  instance?: Instance
}
const { kind, series, edition, part, instance } = Astro.props as Props
---

{kind === 'series' && <SeriesPage series={series} />}
{kind === 'edition' && edition && <EditionPage series={series} edition={edition} />}
{kind === 'part' && edition && part && <PartPage series={series} edition={edition} part={part} />}
{kind === 'instance' && edition && instance && <InstancePage series={series} edition={edition} part={part} instance={instance} />}
