---
import { BROWSE_DROPDOWN } from '../data/nav-config'
import { BASE_PATH } from '../data/publications'
import NavMenu from './NavMenu.vue'
import MobileNav from './MobileNav.vue'

interface Props {
  currentPath?: string
}
const { currentPath = '' } = Astro.props
const root = BASE_PATH
---

<header class="site-nav sticky top-0 z-[100] bg-paper-soft/90 dark:bg-paper-deep/90 backdrop-blur border-b border-rule">
  <div class="max-w-7xl mx-auto px-6 flex items-center justify-between h-14">
    <!-- Brand -->
    <a href={`${root}/`} class="flex items-center gap-2 no-underline text-ink min-w-0">
      <img src={`${root}/oiml-logo-icon-light.svg`} alt="" class="logo-light h-7 w-auto shrink-0" />
      <img src={`${root}/oiml-logo-icon-dark.svg`} alt="" class="logo-dark h-7 w-auto shrink-0" />
      <span class="font-serif text-base font-semibold tracking-tight truncate">
        OIML <span class="text-accent">Publications</span>
      </span>
    </a>

    <!-- Desktop nav (Vue island) -->
    <NavMenu client:load currentPath={currentPath} />

    <!-- Mobile nav (Vue island) -->
    <MobileNav client:load basePath={root} />
  </div>
</header>
