---
import Base from '../layouts/Base.astro'
import type { PubInstance } from '../data/types'
import { loadDataset, BASE_PATH } from '../data/publications'
import PdfPreview from './PdfPreview.astro'
import RelationList from './RelationList.astro'
import DoctypeChip from './DoctypeChip.astro'
import StatusBadge from './StatusBadge.astro'
import { LANG_LABELS } from '../data/types'

export interface Props {
  instance: PubInstance
}
const { instance: inst } = Astro.props
const data = loadDataset()

const title = inst.title[inst.language] ?? inst.title.eng ?? inst.title.fra ?? inst.docid
const siblingInstances = inst.instances
  .filter(id => id !== inst.id)
  .map(id => data.instances.get(id))
  .filter((x): x is PubInstance => Boolean(x))
  .sort((a, b) => a.language.localeCompare(b.language))
const workSlug = inst.id
  .replace(/-(E|F|Ara|Eng|Fra|Sr|Ukr|Zho|Rus|Pol|Por|Spa|Deu|Chi|FAra|Fa|Cn|Ua|Ro)$/, '')
  .toLowerCase()
  .replace(/[+]/g, '-')
  .replace(/[^a-z0-9-]/g, '-')
---

<Base title={inst.docid} currentPath={`/pub/${inst.slug}`}>
  <slot name="head" slot="head">
    <link rel="alternate" type="application/yaml" href={inst.localYamlPath} />
    {inst.localPdfPath && <link rel="alternate" type="application/pdf" href={inst.localPdfPath} />}
    <meta property="og:title" content={inst.docid} />
    <meta property="og:description" content={inst.scope ?? title} />
    {inst.doi && <meta name="citation_doi" content={inst.doi} />}
    {inst.publishedAt && <meta name="citation_publication_date" content={inst.publishedAt} />}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': ['Standard', 'CreativeWork'],
      '@id': `${BASE_PATH}/pub/${inst.slug}/`,
      identifier: inst.docid,
      name: title,
      description: inst.scope,
      datePublished: inst.publishedAt,
      inLanguage: inst.language,
      encoding: inst.localPdfPath ? [{
        '@type': 'MediaObject',
        encodingFormat: 'application/pdf',
        contentUrl: inst.localPdfPath,
      }] : undefined,
      doi: inst.doi,
      publisher: { '@type': 'Organization', name: 'OIML' },
    })} />
  </slot>

  <section class="px-8 pt-10 pb-6 border-b border-rule">
    <div class="max-w-7xl mx-auto">
      <a href={`${BASE_PATH}/pub/${workSlug}/`} class="text-xs font-mono text-ink-soft hover:text-accent">← back to work</a>
      <div class="flex items-center gap-2 mt-2 mb-3 flex-wrap">
        <DoctypeChip doctype={inst.doctype} />
        <span class="px-2 py-0.5 text-xs font-mono uppercase border border-rule rounded-sm">{inst.language}</span>
        <span class="text-xs text-ink-soft">{LANG_LABELS[inst.language] ?? inst.language}</span>
        <StatusBadge status={inst.status} replacedBy={inst.replacedBy} />
      </div>
      <h1 class="font-serif text-3xl font-medium leading-tight tracking-tight mb-2">{title}</h1>
      <p class="font-mono text-sm text-ink-soft">{inst.docid}</p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-8 py-6 grid lg:grid-cols-[1fr_22rem] gap-6">
    <div>
      {inst.localPdfPath ? (
        <PdfPreview pdfPath={inst.localPdfPath.replace(`${BASE_PATH}/pdfs/`, '')} />
      ) : (
        <div class="border border-rule p-8 rounded-sm bg-paper-soft dark:bg-paper">
          <p class="text-ink-soft">No PDF available locally.</p>
          {inst.sourceUrl && (
            <a href={inst.sourceUrl} class="text-accent hover:underline text-sm font-mono mt-2 inline-block">{inst.sourceUrl}</a>
          )}
        </div>
      )}

      {siblingInstances.length > 0 && (
        <section class="mt-8">
          <h2 class="font-serif text-xl mb-3">Other languages</h2>
          <div class="flex gap-2 flex-wrap">
            {siblingInstances.map(s => (
              <a href={`${BASE_PATH}/pub/${s.slug}/`} class="px-3 py-1.5 text-sm border border-rule rounded-sm hover:border-accent hover:shadow-sm transition-all">
                {s.language} · {LANG_LABELS[s.language] ?? s.language}
              </a>
            ))}
          </div>
        </section>
      )}
    </div>

    <aside class="space-y-6 text-sm">
      <div>
        <h2 class="font-serif text-lg mb-2">Metadata</h2>
        <dl class="space-y-2 font-mono text-xs">
          {inst.year && (<div class="flex justify-between gap-2"><dt class="text-ink-soft uppercase tracking-wide">Published</dt><dd>{inst.year}</dd></div>)}
          {inst.tc && (<div class="flex justify-between gap-2"><dt class="text-ink-soft uppercase tracking-wide">TC / SC</dt><dd>{inst.tc}</dd></div>)}
          {inst.fileSize && (<div class="flex justify-between gap-2"><dt class="text-ink-soft uppercase tracking-wide">PDF size</dt><dd>{Math.round(inst.fileSize / 1024 / 1024 * 10) / 10} MB</dd></div>)}
          {inst.doi && (<div class="flex justify-between gap-2"><dt class="text-ink-soft uppercase tracking-wide">DOI</dt><dd><a class="text-accent hover:underline" href={`https://doi.org/${inst.doi}`}>{inst.doi}</a></dd></div>)}
        </dl>
      </div>

      {inst.scope && (
        <div>
          <h2 class="font-serif text-lg mb-2">Scope</h2>
          <p class="text-ink-soft leading-relaxed">{inst.scope}</p>
        </div>
      )}

      <div>
        <h2 class="font-serif text-lg mb-2">Downloads</h2>
        <ul class="space-y-1 text-xs font-mono">
          {inst.localPdfPath && <li><a href={inst.localPdfPath} class="text-accent hover:underline">⬇ PDF (local mirror)</a></li>}
          {inst.sourceUrl && <li><a href={inst.sourceUrl} class="text-accent hover:underline">⬆ Upstream ({new URL(inst.sourceUrl).host})</a></li>}
          <li><a href={inst.localYamlPath} class="text-accent hover:underline">⬇ YAML record</a></li>
          <li><a href={`${BASE_PATH}/api/publications/${inst.slug}`} class="text-accent hover:underline">⬇ JSON record</a></li>
        </ul>
      </div>

      {inst.relations.length > 0 && (
        <div>
          <h2 class="font-serif text-lg mb-2">Relations</h2>
          <RelationList relations={inst.relations} selfId={inst.docid} />
        </div>
      )}
    </aside>
  </div>
</Base>
