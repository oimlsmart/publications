---
import { BASE_PATH } from '../data/publications'
const root = BASE_PATH
const year = new Date().getFullYear()
---

<footer class="border-t border-rule bg-paper-deep mt-16">
  <div class="max-w-7xl mx-auto px-6 py-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2 mb-3">
          <img src={`${root}/oiml-logo-icon-light.svg`} alt="" class="logo-light h-8 w-auto" />
          <img src={`${root}/oiml-logo-icon-dark.svg`} alt="" class="logo-dark h-8 w-auto" />
          <span class="font-serif text-sm font-semibold">OIML Publications</span>
        </div>
        <p class="text-xs text-ink-muted leading-relaxed max-w-xs">
          A public archive of every OIML publication — Recommendations,
          Documents, Guides, Vocabularies, Basic Publications, Expert
          Reports, and Seminar Reports — with bibliographic data and PDFs.
        </p>
      </div>

      <!-- Explore -->
      <div>
        <h3 class="text-xs font-mono uppercase tracking-wider text-ink-muted mb-3">Explore</h3>
        <ul class="space-y-2">
          <li><a href={`${root}/browse/`} class="text-sm text-ink-soft hover:text-accent transition-colors">All publications</a></li>
          <li><a href={`${root}/browse/recommendation/`} class="text-sm text-ink-soft hover:text-accent transition-colors">Recommendations</a></li>
          <li><a href={`${root}/browse/document/`} class="text-sm text-ink-soft hover:text-accent transition-colors">Documents</a></li>
          <li><a href={`${root}/browse/guide/`} class="text-sm text-ink-soft hover:text-accent transition-colors">Guides</a></li>
          <li><a href={`${root}/browse/vocabulary/`} class="text-sm text-ink-soft hover:text-accent transition-colors">Vocabularies</a></li>
          <li><a href={`${root}/search/`} class="text-sm text-ink-soft hover:text-accent transition-colors">Search</a></li>
        </ul>
      </div>

      <!-- Programme -->
      <div>
        <h3 class="text-xs font-mono uppercase tracking-wider text-ink-muted mb-3">Programme</h3>
        <ul class="space-y-2 mb-4">
          <li><a href="https://www.oimlsmart.org/" class="text-sm text-ink-soft hover:text-accent transition-colors">OIML SMART</a></li>
          <li><a href="https://www.oiml.org/" class="text-sm text-ink-soft hover:text-accent transition-colors">OIML (official site)</a></li>
          <li><a href={`${root}/api/publications.json`} class="text-sm text-ink-soft hover:text-accent transition-colors">JSON API</a></li>
        </ul>
        <a href="https://github.com/oimlsmart/publications" class="inline-flex items-center gap-2 text-sm text-ink-soft hover:text-accent transition-colors" aria-label="OIML Publications on GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="shrink-0">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </div>

    <div class="pt-6 border-t border-rule-soft flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-ink-muted text-center sm:text-left">
        Data mirrored from <a href="https://github.com/relaton/relaton-data-oiml" class="text-accent hover:underline">relaton-data-oiml</a>.
        PDFs © OIML, mirrored from <a href="https://www.oiml.org/publications" class="text-accent hover:underline">oiml.org</a> for public access.
      </p>
      <p class="text-xs text-ink-muted whitespace-nowrap">© {year} OIML</p>
    </div>
  </div>
</footer>
