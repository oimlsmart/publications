---
import { BASE_PATH } from '../data/publications'
import { pdfUrl } from '../data/urls'
import PdfViewer from './PdfViewer.vue'

interface Props {
  pdfPath: string
}
const { pdfPath } = Astro.props
const url = pdfUrl(pdfPath)
---

<!-- Vue island injects and awaits the local pdf.js UMD build itself (loadPdfJs) -->
<PdfViewer client:visible pdfUrl={url} basePath={BASE_PATH} />
