---
import type { Doctype } from '../data/types'
import { DOCTYPE_LABELS } from '../data/types'

interface Props {
  doctype: Doctype
  class?: string
}

const { doctype, class: cls = '' } = Astro.props
const label = DOCTYPE_LABELS[doctype]

// Per-doctype color, mirroring OIML's standard color coding
const colors: Record<Doctype, string> = {
  'recommendation':    'bg-brand-100 text-brand-800 dark:bg-brand-900/40 dark:text-brand-100 border-brand-300 dark:border-brand-700',
  'basic-publication': 'bg-purple-100 text-purple-900 dark:bg-purple-900/40 dark:text-purple-100 border-purple-300 dark:border-purple-800',
  'document':          'bg-teal-100 text-teal-900 dark:bg-teal-900/40 dark:bg-teal-100 border-teal-300 dark:border-teal-800',
  'guide':             'bg-indigo-100 text-indigo-900 dark:bg-indigo-900/40 dark:text-indigo-100 border-indigo-300 dark:border-indigo-800',
  'expert-report':     'bg-orange-100 text-orange-900 dark:bg-orange-900/40 dark:text-orange-100 border-orange-300 dark:border-orange-800',
  'seminar-report':    'bg-pink-100 text-pink-900 dark:bg-pink-900/40 dark:text-pink-100 border-pink-300 dark:border-pink-800',
  'vocabulary':        'bg-emerald-100 text-emerald-900 dark:bg-emerald-900/40 dark:text-emerald-100 border-emerald-300 dark:border-emerald-800',
  'translation':       'bg-gray-100 text-gray-900 dark:bg-gray-900/40 dark:text-gray-100 border-gray-300 dark:border-gray-800',
}
---

<span class={`inline-block px-2 py-0.5 text-xs font-mono uppercase tracking-wide border rounded-sm ${colors[doctype]} ${cls}`}>
  {label.singular}
</span>
