---
import type { Doctype, Status, PubWork, PubInstance } from '../data/types'
import { DOCTYPE_LABELS, LANG_LABELS } from '../data/types'

interface Props {
  status: Status
  replacedBy?: string[]
}

const { status, replacedBy = [] } = Astro.props

const styles: Record<Status, string> = {
  'in-force':   'bg-green-100 text-green-900 dark:bg-green-900/40 dark:text-green-100 border-green-300 dark:border-green-800',
  'superseded': 'bg-amber-100 text-amber-900 dark:bg-amber-900/40 dark:text-amber-100 border-amber-300 dark:border-amber-800',
  'withdrawn':  'bg-red-100 text-red-900 dark:bg-red-900/40 dark:text-red-100 border-red-300 dark:border-red-800',
  'draft':      'bg-blue-100 text-blue-900 dark:bg-blue-900/40 dark:text-blue-100 border-blue-300 dark:border-blue-800',
  'unknown':    'bg-paper-soft text-ink-soft border-rule',
}

const labels: Record<Status, string> = {
  'in-force': 'In force',
  'superseded': 'Superseded',
  'withdrawn': 'Withdrawn',
  'draft': 'Draft',
  'unknown': 'Status unknown',
}
---

<span class={`inline-flex items-center px-2 py-0.5 text-xs font-mono uppercase tracking-wide border rounded-sm ${styles[status]}`}>
  {labels[status]}
</span>
{replacedBy.length > 0 && (
  <span class="text-xs text-ink-soft ml-1">
    by {replacedBy.join(', ')}
  </span>
)}
