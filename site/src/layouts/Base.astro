---
/**
 * The publications site's base layout — wraps @oimlsmart/site-shell's
 * Base (the federation chrome, TODO.fix/09) and keeps the local
 * contract the pages already use (title/description props, the
 * slot name="head" for pagefind and per-page assets). The minisite's
 * own sections ride the shell's MinisiteNav; the federation header
 * and footer come from the shell.
 */
import { Base as ShellBase, MinisiteNav } from '@oimlsmart/site-shell'
import SITE from '../data/site-meta'
import '../styles/app.css'

interface Props {
  title?: string
  description?: string
  /** Kept for call-site compatibility; the shell derives active state. */
  currentPath?: string
}

const NAV = [
  { label: 'About', href: '/' },
  { label: 'Browse', href: '/browse/' },
  { label: 'Search', href: '/search/' },
]

const { title, description } = Astro.props
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title
---

<ShellBase title={pageTitle} description={description ?? SITE.description} siteTitle="OIML SMART">
  <link rel="icon" type="image/svg+xml" href={`${SITE.basePath}/favicon.svg`} slot="head" />
  <link rel="apple-touch-icon" href={`${SITE.basePath}/apple-touch-icon.png`} slot="head" />
  <slot name="head" slot="head" />
  <MinisiteNav sections={NAV} base="/publications" />
  <slot />
</ShellBase>
