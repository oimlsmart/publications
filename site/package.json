{
  "name": "oiml-publications-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static browser site for oimlsmart/publications",
  "scripts": {
    "dev": "node scripts/dev-setup.mjs && astro dev",
    "build": "node scripts/build-cleanup.mjs && astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/vue": "^7.0.1",
    "astro": "^7.0.7",
    "vue": "^3.5.40",
    "@oimlsmart/site-shell": "file:../vendor/site-shell"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.2",
    "vitest": "^4.1.10",
    "yaml": "^2.8.0"
  }
}
